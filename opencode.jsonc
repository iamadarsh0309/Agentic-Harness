{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000,
    },
    "buffer": 20000,
  },
  "providers": {
    "opencode": {
      "models": {
        "deepseek-v4.1-flash-free": {
          "body": {
            "temperature": 0.1,
            "reasoning_effort": "none",
          },
        },
      },
    },
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
      },
    },
  },
  "watcher": {
    "ignore": ["logs/**"],
  },
  "permissions": [
    
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow",
    },
    {
      "action": "subagent",
      "resource": "explore",
      "effect": "deny",
    },

    { "action": "read", 
      "resource": "*.env", 
     "effect": "deny"
   },
    {
      "action": "skill",
      "resource": "create-test-program",
      "effect": "ask"
    },
  ],
}
