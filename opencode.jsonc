{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000,
    },
    "buffer": 20000,
  },
  "providers": {
    "opencode": {
      "models": {
        "deepseek-v4.1-flash-free": {
          "body": {
            "temperature": 0.1,
            "reasoning_effort": "none",
          },
        },
      },
    },
  },
  "watcher": {
    "ignore": ["logs/**"],
  },
  "permissions": [
    { "action": "read", "resource": "*.secrets", "effect": "deny" },
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow",
    },
    {
      "action": "subagent",
      "resource": "explore",
      "effect": "deny",
    },
  ],
}
